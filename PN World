class MCQPage extends StatefulWidget {
  const MCQPage({super.key});

  @override
  State<MCQPage> createState() => _MCQPageState();
}

class _MCQPageState extends State<MCQPage> {
  final Map<int, int> selectedAnswers = {};
  final Set<int> explanationsShown = {};
  final labels = ['ক', 'খ', 'গ', 'ঘ'];

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: questionBankNotifier,
      builder: (context, child) {
        final questions = questionBankNotifier.questions;
        return ListView.builder(
          padding: const EdgeInsets.all(12),
          itemCount: questions.length,
          itemBuilder: (context, index) {
            final q = questions[index];
            final selected = selectedAnswers[index];

            return Card(
              margin: const EdgeInsets.only(bottom: 16),
              elevation: 2,
              child: Padding(
                padding: const EdgeInsets.all(14),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('প্রশ্ন ${index + 1}: ${q.text}',
                      style: const TextStyle(fontSize: 17, fontWeight: FontWeight.bold)),
                    const SizedBox(height: 12),
                    ...List.generate(4, (i) {
                      final isCorrect = i == q.answer;
                      final isWrong = selected == i && !isCorrect;
                      final bg = selected == null
                          ? Colors.white
                          : isCorrect
                              ? const Color(0xFFB9F6CA)
                              : isWrong
                                  ? const Color(0xFFFFCDD2)
                                  : Colors.white;
                      final border = selected == null
                          ? Colors.grey.shade400
                          : isCorrect
                              ? Colors.green
                              : isWrong
                                  ? Colors.red
                                  : Colors.grey.shade300;

                      return Container(
                        width: double.infinity,
                        margin: const EdgeInsets.only(bottom: 9),
                        child: ElevatedButton(
                          onPressed: () {
                            if (selected == null) {
                              setState(() => selectedAnswers[index] = i);
                            }
                          },
                          style: ElevatedButton.styleFrom(
                            backgroundColor: bg,
                            foregroundColor: Colors.black87,
                            elevation: 0,
                            alignment: Alignment.centerLeft,
                            padding: const EdgeInsets.all(16),
                            side: BorderSide(color: border, width: 1.5),
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(12)),
                          ),
                          child: Row(
                            children: [
                              Expanded(child: Text('${labels[i]}. ${q.options[i]}',
                                style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600))),
                              if (selected != null && isCorrect)
                                const Icon(Icons.check_circle, color: Colors.green),
                              if (selected != null && isWrong)
                                const Icon(Icons.cancel, color: Colors.red),
                            ],
                          ),
                        ),
                      );
                    }),
                    OutlinedButton.icon(
                      onPressed: () => setState(() {
                        if (explanationsShown.contains(index)) {
                          explanationsShown.remove(index);
                        } else {
                          explanationsShown.add(index);
                        }
                      }),
                      icon: const Icon(Icons.lightbulb_outline),
                      label: Text(explanationsShown.contains(index)
                          ? 'ব্যাখ্যা বন্ধ করুন' : 'ব্যাখ্যা দেখুন'),
                    ),
                    if (explanationsShown.contains(index))
                      Padding(
                        padding: const EdgeInsets.only(top: 8),
                        child: Text('ব্যাখ্যা: ${q.explanation}',
                          style: const TextStyle(fontSize: 15)),
                      ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }
}

