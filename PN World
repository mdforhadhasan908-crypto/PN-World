// -------------------- ADMIN PAGE --------------------

class AdminPage extends StatefulWidget {
  const AdminPage({super.key});

  @override
  State<AdminPage> createState() => _AdminPageState();
}

class _AdminPageState extends State<AdminPage> {
  final questionController = TextEditingController();
  final optionA = TextEditingController();
  final optionB = TextEditingController();
  final optionC = TextEditingController();
  final optionD = TextEditingController();
  final explanationController = TextEditingController();

  int correctAnswer = 0;
  int? editingIndex;

  List<TextEditingController> get optionControllers =>
      [optionA, optionB, optionC, optionD];

  @override
  void dispose() {
    questionController.dispose();
    optionA.dispose();
    optionB.dispose();
    optionC.dispose();
    optionD.dispose();
    explanationController.dispose();
    super.dispose();
  }

  void clearForm() {
    questionController.clear();
    optionA.clear();
    optionB.clear();
    optionC.clear();
    optionD.clear();
    explanationController.clear();
    setState(() {
      correctAnswer = 0;
      editingIndex = null;
    });
  }

  void loadQuestion(int index) {
    final q = questionBankNotifier.questions[index];
    questionController.text = q.text;
    optionA.text = q.options[0];
    optionB.text = q.options[1];
    optionC.text = q.options[2];
    optionD.text = q.options[3];
    explanationController.text = q.explanation;

    setState(() {
      correctAnswer = q.answer;
      editingIndex = index;
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('প্রশ্নটি এডিট করার জন্য লোড হয়েছে')),
    );
  }

  void saveQuestion() {
    final text = questionController.text.trim();
    final options = optionControllers.map((c) => c.text.trim()).toList();
    final explanation = explanationController.text.trim();

    if (text.isEmpty || options.any((v) => v.isEmpty) || explanation.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('সব ঘর পূরণ করুন')),
      );
      return;
    }

    final q = Question(text, options, correctAnswer, explanation);

    if (editingIndex == null) {
      questionBankNotifier.add(q);
    } else {
      questionBankNotifier.edit(editingIndex!, q);
    }

    clearForm();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(editingIndex == null
          ? 'প্রশ্ন যোগ হয়েছে'
          : 'প্রশ্ন আপডেট হয়েছে')),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('PN World অ্যাডমিন'),
        backgroundColor: Colors.deepPurple,
        foregroundColor: Colors.white,
        actions: [
          IconButton(
            tooltip: 'লগআউট',
            icon: const Icon(Icons.logout),
            onPressed: () => Navigator.pushAndRemoveUntil(
              context,
              MaterialPageRoute(builder: (_) => const HomePage()),
              (route) => false,
            ),
          ),
        ],
      ),
      body: AnimatedBuilder(
        animation: questionBankNotifier,
        builder: (context, child) {
          final questions = questionBankNotifier.questions;

          return ListView(
            padding: const EdgeInsets.all(16),
            children: [
              const Text('অ্যাডমিন ড্যাশবোর্ড',
                style: TextStyle(fontSize: 25, fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              const Text('এখান থেকে MCQ প্রশ্ন যোগ, এডিট ও মুছে ফেলতে পারবেন।'),
              const SizedBox(height: 25),

              Text(editingIndex == null ? 'নতুন MCQ যোগ করুন' : 'MCQ প্রশ্ন এডিট করুন',
                style: const TextStyle(fontSize: 21, fontWeight: FontWeight.bold)),
              const SizedBox(height: 14),

              TextField(
                controller: questionController,
                maxLines: 3,
                decoration: const InputDecoration(
                  labelText: 'প্রশ্ন লিখুন',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),

              ...List.generate(4, (i) => Padding(
                padding: const EdgeInsets.only(bottom: 10),
                child: TextField(
                  controller: optionControllers[i],
                  decoration: InputDecoration(
                    labelText: 'অপশন ${['ক', 'খ', 'গ', 'ঘ'][i]}',
                    border: const OutlineInputBorder(),
                  ),
                ),
              )),

              const Text('সঠিক উত্তর নির্বাচন করুন',
                style: TextStyle(fontWeight: FontWeight.bold)),
              ...List.generate(4, (i) => RadioListTile<int>(
                title: Text('অপশন ${['ক', 'খ', 'গ', 'ঘ'][i]}'),
                value: i,
                groupValue: correctAnswer,
                onChanged: (v) => setState(() => correctAnswer = v!),
              )),

              TextField(
                controller: explanationController,
                maxLines: 3,
                decoration: const InputDecoration(
                  labelText: 'ব্যাখ্যা লিখুন',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 15),

              SizedBox(
                width: double.infinity,
                child: ElevatedButton.icon(
                  onPressed: saveQuestion,
                  icon: Icon(editingIndex == null ? Icons.add : Icons.save),
                  label: Text(editingIndex == null ? 'প্রশ্ন যোগ করুন' : 'পরিবর্তন সংরক্ষণ করুন'),
                ),
              ),

              if (editingIndex != null)
                TextButton.icon(
                  onPressed: clearForm,
                  icon: const Icon(Icons.close),
                  label: const Text('এডিট বাতিল করুন'),
                ),

              const Divider(height: 35),
              Text('প্রশ্ন তালিকা (${questions.length}টি)',
                style: const TextStyle(fontSize: 21, fontWeight: FontWeight.bold)),
              const SizedBox(height: 10),

              ...List.generate(questions.length, (index) {
                final q = questions[index];
                return Card(
                  child: ListTile(
                    isThreeLine: true,
                    title: Text('${index + 1}. ${q.text}'),
                    subtitle: Text('সঠিক উত্তর: ${q.options[q.answer]}'),
                    trailing: PopupMenuButton<String>(
                      onSelected: (value) {
                        if (value == 'edit') {
                          loadQuestion(index);
                        } else if (value == 'delete') {
                          showDialog(
                            context: context,
                            builder: (dialogContext) => AlertDialog(
                              title: const Text('প্রশ্ন মুছবেন?'),
                              content: const Text('এই প্রশ্নটি মুছে ফেলতে চান?'),
                              actions: [
                                TextButton(
                                  onPressed: () => Navigator.pop(dialogContext),
                                  child: const Text('না'),
                                ),
                                TextButton(
                                  onPressed: () {
                                    questionBankNotifier.remove(index);
                                    if (editingIndex == index) clearForm();
                                    Navigator.pop(dialogContext);
                                  },
                                  child: const Text('হ্যাঁ, মুছুন'),
                                ),
                              ],
                            ),
                          );
                        }
                      },
                      itemBuilder: (_) => const [
                        PopupMenuItem(value: 'edit', child: Text('এডিট করুন')),
                        PopupMenuItem(value: 'delete', child: Text('ডিলিট করুন')),
                      ],
                    ),
                  ),
                );
              }),
            ],
          );
        },
      ),
    );
  }
}
