List<String> subjectsFor(String category) {
  if (category == 'BCS প্রস্তুতি') {
    return [
      'বাংলা ভাষা ও সাহিত্য',
      'English Language and Literature',
      'বাংলাদেশ বিষয়াবলি',
      'আন্তর্জাতিক বিষয়াবলি',
      'ভূগোল ও পরিবেশ',
      'সাধারণ বিজ্ঞান',
      'কম্পিউটার ও ICT',
      'গাণিতিক যুক্তি',
      'মানসিক দক্ষতা',
      'নৈতিকতা ও সুশাসন',
