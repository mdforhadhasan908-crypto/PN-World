    Question('আন্তর্জাতিক মাতৃভাষা দিবস কবে?',
        ['১৬ ডিসেম্বর', '২৬ মার্চ', '২১ ফেব্রুয়ারি', '১ মে'], 2,
        '২১ ফেব্রুয়ারি আন্তর্জাতিক মাতৃভাষা দিবস।'),
    Question('বাংলাদেশের জাতীয় পাখি কোনটি?',
        ['কাক', 'দোয়েল', 'ময়না', 'টিয়া'], 1,
        'দোয়েল বাংলাদেশের জাতীয় পাখি।'),
    Question('বাংলাদেশের স্বাধীনতা দিবস কবে?',
        ['২৬ মার্চ', '১৬ ডিসেম্বর', '২১ ফেব্রুয়ারি', '১ জানুয়ারি'], 0,
        '২৬ মার্চ বাংলাদেশের স্বাধীনতা দিবস।'),
  ];

  void add(Question q) {
    questions.add(q);
    notifyListeners();
  }

  void edit(int index, Question q) {
    questions[index] = q;
    notifyListeners();
  }

  void remove(int index) {
    questions.removeAt(index);
    notifyListeners();
  }
}

